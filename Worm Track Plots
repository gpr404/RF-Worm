#Make unique Colors per group
generate_unique_colors <- function(unique_ids, control_id = NULL, control_color = NULL) {
  # Calculate the number of unique IDs
  num_ids <- length(unique_ids)
  
  # Calculate equally spaced hues for non-control groups
  hues <- seq(15, 375, length.out = num_ids + 1)
  hues <- hues[-(num_ids + 1)]  # Remove last hue to avoid repetition
  
  # Generate colors in HCL color space for non-control groups
  colors <- hcl(h = hues, c = 100, l = 65)
  
  # Convert to hexadecimal format
  hex_colors <- grDevices::col2rgb(colors)
  hex_colors <- apply(hex_colors, 2, function(col) {
    rgb(col[1], col[2], col[3], maxColorValue = 255)
  })
  
  # Create a named vector of colors with IDs as names
  id_color_map <- setNames(hex_colors, unique_ids)
  
  # If control group ID and color are specified, assign them
  if (!is.null(control_id) && !is.null(control_color)) {
    id_color_map[control_id] <- control_color
  }
  
  # Return the named vector of colors
  return(id_color_map)
}



