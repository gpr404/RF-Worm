### Calculate Centers for LDA
# Function for centers calculation 
find.center<-function(x){
  require(stats)
  require(dplyr)
  require(MASS)
  x<- x %>% rename(LD1.og= LD1, LD2.og= LD2)
  weight<- x$weight %||% rep(1, nrow(x))
  weight <- weight / sum(weight)
  ellipse<- MASS::cov.trob(x[c('LD1.og', 'LD2.og')], wt= weight * nrow(x))
  center<-as.data.frame(ellipse$center)
  center<-t(center)
  center2<-as.data.frame(center)
  z<- cbind(x,center2)
  z<- z %>% rename(LD1=1,LD2=2,LD1.cent=54,LD2.cent=55)
  return(z)
}
